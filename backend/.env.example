# Database Configuration
DATABASE_URL=postgresql://civilcortex:your_secure_password_here@db:5432/civilcortex

# Security & Authentication
ENVIRONMENT=production
SECRET_KEY=generate-a-secure-random-key-here
BACKEND_CORS_ORIGINS='["http://localhost:5173","https://your-production-domain.com"]'

# AI & External Services
GEMINI_API_KEY=your_gemini_api_key_here

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=civilcortex_admin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_SECURE=false
MINIO_BUCKET_NAME=civilcortex-images

# Application Modes
DEMO_MODE=false
DEFAULT_DEMO_SCENARIO=hairline_crack
