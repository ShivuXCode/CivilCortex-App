# Database Configuration
POSTGRES_USER=civilcortex
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=civilcortex
DATABASE_URL=postgresql://civilcortex:your_secure_postgres_password_here@db:5432/civilcortex

# Security & Authentication
ENVIRONMENT=development
SECRET_KEY=your-secret-key-min-32-chars-change-in-production
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost

# AI & External Services
GEMINI_API_KEY=your_google_gemini_api_key_here

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO Storage
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=civilcortex_admin
MINIO_ROOT_PASSWORD=your_secure_minio_password_here
MINIO_SECURE=false
MINIO_BUCKET_NAME=civilcortex-images

# Application Modes
DEMO_MODE=false
DEFAULT_DEMO_SCENARIO=hairline_crack
